{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.arkheos.ai/schemas/release.json",
  "title": "ArkheOS signed product release",
  "type": "object",
  "required": ["schema", "product", "channel", "version", "publishedAt", "expiresAt", "minimumCodexVersion", "artifacts", "signature"],
  "properties": {
    "schema": {"const": "arkheos.release/v1"}, "product": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}, "channel": {"const": "stable"}, "version": {"type": "string"}, "publishedAt": {"type": "string", "format": "date-time"}, "expiresAt": {"type": "string", "format": "date-time"}, "minimumCodexVersion": {"type": "string"},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["platform", "sha256", "length", "url"], "properties": {"platform": {"enum": ["windows", "macos", "linux"]}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "length": {"type": "integer", "minimum": 1}, "url": {"type": "string", "pattern": "^https://api\\.arkheos\\.ai/v1/artifacts/[a-f0-9]{64}$"}}, "additionalProperties": false}},
    "signature": {"type": "object", "required": ["algorithm", "keyId", "value"], "properties": {"algorithm": {"const": "Ed25519"}, "keyId": {"type": "string"}, "value": {"type": "string"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
