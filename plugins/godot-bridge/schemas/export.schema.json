{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "godot-bridge/export/v1",
  "oneOf": [
    {"$ref": "#/$defs/observation"},
    {"$ref": "#/$defs/receipt"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "observation": {
      "type": "object",
      "required": ["schema", "status", "ready", "projectRoot", "projectRevision", "engine", "templates", "presetFile", "blockers"],
      "properties": {
        "schema": {"const": "godot-bridge/export-observation/v1"},
        "status": {"enum": ["ready", "blocked"]},
        "ready": {"type": "boolean"},
        "projectRoot": {"type": "string"},
        "projectRevision": {"$ref": "#/$defs/sha256"},
        "engine": {"type": "object"},
        "templates": {"type": "object"},
        "presetFile": {"type": "object"},
        "preset": {"type": ["object", "null"]},
        "blockers": {"type": "array", "maxItems": 32, "items": {"type": "object", "required": ["code", "message"]}}
      },
      "additionalProperties": true
    },
    "receipt": {
      "type": "object",
      "required": ["schema", "receiptId", "status", "classification", "projectRoot", "projectRevision", "artifact", "createdAt"],
      "properties": {
        "schema": {"const": "godot-bridge/export-receipt/v1"},
        "receiptId": {"$ref": "#/$defs/sha256"},
        "status": {"const": "verified"},
        "classification": {"const": "artifact-verified"},
        "projectRoot": {"type": "string"},
        "projectRevision": {"$ref": "#/$defs/sha256"},
        "artifact": {
          "type": "object",
          "required": ["name", "path", "bytes", "sha256"],
          "properties": {
            "name": {"type": "string"},
            "path": {"type": "string"},
            "bytes": {"type": "integer", "minimum": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        },
        "createdAt": {"type": "string"}
      },
      "additionalProperties": true
    }
  }
}

