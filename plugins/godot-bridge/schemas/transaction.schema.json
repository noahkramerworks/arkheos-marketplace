{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "godot-bridge/transaction/v1",
  "type": "object",
  "required": ["projectRoot", "transactionId", "expectedRevision", "actions"],
  "properties": {
    "projectRoot": {"type": "string", "minLength": 3},
    "transactionId": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,160}$"},
    "expectedRevision": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "scenePath": {"$ref": "#/$defs/scenePath"},
    "actions": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "#/$defs/action"}}
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,159}$"},
    "aliasName": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,79}$"},
    "resourcePath": {"type": "string", "pattern": "^res://(?!.*\\.\\.)[^\\\\]+$"},
    "scenePath": {"type": "string", "pattern": "^res://(?!.*\\.\\.)[^\\\\]+\\.tscn$"},
    "scriptPath": {"type": "string", "pattern": "^res://(?!.*\\.\\.)[^\\\\]+\\.gd$"},
    "storedResourcePath": {"type": "string", "pattern": "^res://(?!.*\\.\\.)[^\\\\]+\\.(?:tres|res)$"},
    "aliasReference": {"type": "object", "required": ["$type", "alias"], "properties": {"$type": {"const": "Alias"}, "alias": {"$ref": "#/$defs/aliasName"}}, "additionalProperties": false},
    "nodeReference": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 1024}, {"$ref": "#/$defs/aliasReference"}]},
    "numberArray2": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
    "numberArray3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "numberArray4": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
    "numberArray6": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "number"}},
    "numberArray9": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"type": "number"}},
    "numberArray12": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"type": "number"}},
    "vector2": {"type": "object", "required": ["$type", "value"], "properties": {"$type": {"const": "Vector2"}, "value": {"$ref": "#/$defs/numberArray2"}}, "additionalProperties": false},
    "vector3": {"type": "object", "required": ["$type", "value"], "properties": {"$type": {"const": "Vector3"}, "value": {"$ref": "#/$defs/numberArray3"}}, "additionalProperties": false},
    "vector4": {"type": "object", "required": ["$type", "value"], "properties": {"$type": {"const": "Vector4"}, "value": {"$ref": "#/$defs/numberArray4"}}, "additionalProperties": false},
    "color": {"type": "object", "required": ["$type", "value"], "properties": {"$type": {"const": "Color"}, "value": {"$ref": "#/$defs/numberArray4"}}, "additionalProperties": false},
    "rect2": {"type": "object", "required": ["$type", "value"], "properties": {"$type": {"const": "Rect2"}, "value": {"$ref": "#/$defs/numberArray4"}}, "additionalProperties": false},
    "quaternion": {"type": "object", "required": ["$type", "value"], "properties": {"$type": {"const": "Quaternion"}, "value": {"$ref": "#/$defs/numberArray4"}}, "additionalProperties": false},
    "transform2d": {"type": "object", "required": ["$type", "value"], "properties": {"$type": {"const": "Transform2D"}, "value": {"$ref": "#/$defs/numberArray6"}}, "additionalProperties": false},
    "basis": {"type": "object", "required": ["$type", "value"], "properties": {"$type": {"const": "Basis"}, "value": {"$ref": "#/$defs/numberArray9"}}, "additionalProperties": false},
    "transform3d": {"type": "object", "required": ["$type", "value"], "properties": {"$type": {"const": "Transform3D"}, "value": {"$ref": "#/$defs/numberArray12"}}, "additionalProperties": false},
    "nodePathValue": {"type": "object", "required": ["$type", "path"], "properties": {"$type": {"const": "NodePath"}, "path": {"type": "string", "minLength": 1, "maxLength": 1024}}, "additionalProperties": false},
    "resourceValue": {"type": "object", "required": ["$type", "path"], "properties": {"$type": {"const": "Resource"}, "path": {"$ref": "#/$defs/resourcePath"}}, "additionalProperties": false},
    "variantDictionary": {"type": "object", "not": {"required": ["$type"]}, "maxProperties": 2048, "propertyNames": {"maxLength": 160}, "additionalProperties": {"$ref": "#/$defs/variant"}},
    "variant": {"oneOf": [{"type": ["null", "boolean", "number", "string"]}, {"type": "array", "maxItems": 2048, "items": {"$ref": "#/$defs/variant"}}, {"$ref": "#/$defs/variantDictionary"}, {"$ref": "#/$defs/vector2"}, {"$ref": "#/$defs/vector3"}, {"$ref": "#/$defs/vector4"}, {"$ref": "#/$defs/color"}, {"$ref": "#/$defs/rect2"}, {"$ref": "#/$defs/quaternion"}, {"$ref": "#/$defs/transform2d"}, {"$ref": "#/$defs/basis"}, {"$ref": "#/$defs/transform3d"}, {"$ref": "#/$defs/nodePathValue"}, {"$ref": "#/$defs/resourceValue"}, {"$ref": "#/$defs/aliasReference"}]},
    "action": {"oneOf": [{"$ref": "#/$defs/sceneCreate"}, {"$ref": "#/$defs/sceneInstantiate"}, {"$ref": "#/$defs/sceneSave"}, {"$ref": "#/$defs/nodeCreate"}, {"$ref": "#/$defs/nodeRemove"}, {"$ref": "#/$defs/nodeMove"}, {"$ref": "#/$defs/nodeRename"}, {"$ref": "#/$defs/nodeDuplicate"}, {"$ref": "#/$defs/nodeSetProperty"}, {"$ref": "#/$defs/scriptWrite"}, {"$ref": "#/$defs/scriptAttach"}, {"$ref": "#/$defs/scriptDetach"}, {"$ref": "#/$defs/signalConnect"}, {"$ref": "#/$defs/signalDisconnect"}, {"$ref": "#/$defs/resourceCreate"}, {"$ref": "#/$defs/resourceSetProperty"}, {"$ref": "#/$defs/inputActionEnsure"}, {"$ref": "#/$defs/assetImport"}]},
    "sceneCreate": {"type": "object", "required": ["type", "path", "rootType", "rootName"], "properties": {"type": {"const": "scene.create"}, "path": {"$ref": "#/$defs/scenePath"}, "rootType": {"$ref": "#/$defs/identifier"}, "rootName": {"type": "string", "minLength": 1, "maxLength": 255}, "alias": {"$ref": "#/$defs/aliasName"}}, "additionalProperties": false},
    "sceneInstantiate": {"type": "object", "required": ["type", "path", "parent"], "properties": {"type": {"const": "scene.instantiate"}, "path": {"$ref": "#/$defs/scenePath"}, "parent": {"$ref": "#/$defs/nodeReference"}, "alias": {"$ref": "#/$defs/aliasName"}}, "additionalProperties": false},
    "sceneSave": {"type": "object", "required": ["type"], "properties": {"type": {"const": "scene.save"}}, "additionalProperties": false},
    "nodeCreate": {"type": "object", "required": ["type", "parent", "nodeType", "name"], "properties": {"type": {"const": "node.create"}, "parent": {"$ref": "#/$defs/nodeReference"}, "nodeType": {"$ref": "#/$defs/identifier"}, "name": {"type": "string", "minLength": 1, "maxLength": 255}, "alias": {"$ref": "#/$defs/aliasName"}}, "additionalProperties": false},
    "nodeRemove": {"type": "object", "required": ["type", "target"], "properties": {"type": {"const": "node.remove"}, "target": {"$ref": "#/$defs/nodeReference"}}, "additionalProperties": false},
    "nodeMove": {"type": "object", "required": ["type", "target", "parent"], "properties": {"type": {"const": "node.move"}, "target": {"$ref": "#/$defs/nodeReference"}, "parent": {"$ref": "#/$defs/nodeReference"}}, "additionalProperties": false},
    "nodeRename": {"type": "object", "required": ["type", "target", "name"], "properties": {"type": {"const": "node.rename"}, "target": {"$ref": "#/$defs/nodeReference"}, "name": {"type": "string", "minLength": 1, "maxLength": 255}}, "additionalProperties": false},
    "nodeDuplicate": {"type": "object", "required": ["type", "target"], "properties": {"type": {"const": "node.duplicate"}, "target": {"$ref": "#/$defs/nodeReference"}, "parent": {"$ref": "#/$defs/nodeReference"}, "name": {"type": "string", "minLength": 1, "maxLength": 255}, "alias": {"$ref": "#/$defs/aliasName"}}, "additionalProperties": false},
    "nodeSetProperty": {"type": "object", "required": ["type", "target", "property", "value"], "properties": {"type": {"const": "node.set_property"}, "target": {"$ref": "#/$defs/nodeReference"}, "property": {"$ref": "#/$defs/identifier"}, "value": {"$ref": "#/$defs/variant"}}, "additionalProperties": false},
    "scriptWrite": {"type": "object", "required": ["type", "path", "content"], "properties": {"type": {"const": "script.write"}, "path": {"$ref": "#/$defs/scriptPath"}, "content": {"type": "string", "maxLength": 1048576}}, "additionalProperties": false},
    "scriptAttach": {"type": "object", "required": ["type", "target", "scriptPath"], "properties": {"type": {"const": "script.attach"}, "target": {"$ref": "#/$defs/nodeReference"}, "scriptPath": {"$ref": "#/$defs/scriptPath"}}, "additionalProperties": false},
    "scriptDetach": {"type": "object", "required": ["type", "target"], "properties": {"type": {"const": "script.detach"}, "target": {"$ref": "#/$defs/nodeReference"}}, "additionalProperties": false},
    "signalConnect": {"type": "object", "required": ["type", "source", "signal", "target", "method"], "properties": {"type": {"const": "signal.connect"}, "source": {"$ref": "#/$defs/nodeReference"}, "signal": {"$ref": "#/$defs/identifier"}, "target": {"$ref": "#/$defs/nodeReference"}, "method": {"$ref": "#/$defs/identifier"}}, "additionalProperties": false},
    "signalDisconnect": {"type": "object", "required": ["type", "source", "signal", "target", "method"], "properties": {"type": {"const": "signal.disconnect"}, "source": {"$ref": "#/$defs/nodeReference"}, "signal": {"$ref": "#/$defs/identifier"}, "target": {"$ref": "#/$defs/nodeReference"}, "method": {"$ref": "#/$defs/identifier"}}, "additionalProperties": false},
    "resourceCreate": {"type": "object", "required": ["type", "resourceType", "path"], "properties": {"type": {"const": "resource.create"}, "resourceType": {"enum": ["StandardMaterial3D", "ShaderMaterial", "Theme", "StyleBoxFlat", "Gradient", "GradientTexture1D", "Curve", "Curve2D", "Curve3D", "Animation", "AnimationLibrary", "BoxMesh", "SphereMesh", "CapsuleMesh", "QuadMesh", "RectangleShape2D", "CircleShape2D", "BoxShape3D", "SphereShape3D", "CapsuleShape3D"]}, "path": {"$ref": "#/$defs/storedResourcePath"}, "properties": {"type": "object", "maxProperties": 512, "propertyNames": {"$ref": "#/$defs/identifier"}, "additionalProperties": {"$ref": "#/$defs/variant"}}, "alias": {"$ref": "#/$defs/aliasName"}}, "additionalProperties": false},
    "resourceSetProperty": {"type": "object", "required": ["type", "path", "property", "value"], "properties": {"type": {"const": "resource.set_property"}, "path": {"$ref": "#/$defs/storedResourcePath"}, "property": {"$ref": "#/$defs/identifier"}, "value": {"$ref": "#/$defs/variant"}}, "additionalProperties": false},
    "inputActionEnsure": {"type": "object", "required": ["type", "name"], "properties": {"type": {"const": "project.input_action.ensure"}, "name": {"$ref": "#/$defs/identifier"}, "deadzone": {"type": "number", "minimum": 0, "maximum": 1}}, "additionalProperties": false},
    "assetImport": {"type": "object", "required": ["type", "sourcePath", "targetPath"], "properties": {"type": {"const": "asset.import"}, "sourcePath": {"type": "string", "minLength": 3}, "targetPath": {"$ref": "#/$defs/resourcePath"}}, "additionalProperties": false}
  }
}
