{
  "mcpServers": {
    "obs_bridge": {
      "command": "node",
      "args": [
        "./mcp/server.mjs"
      ],
      "cwd": ".",
      "env_vars": [
        "CODEX_HOME",
        "USERPROFILE",
        "OBS_WEBSOCKET_URL",
        "OBS_WEBSOCKET_PASSWORD",
        "PATH"
      ],
      "startup_timeout_sec": 10,
      "tool_timeout_sec": 60
    }
  }
}
