{
  "mcpServers": {
    "freecad_bridge": {
      "command": "node",
      "args": ["./mcp/server.mjs"],
      "cwd": ".",
      "env_vars": ["CODEX_HOME", "USERPROFILE", "APPDATA", "PATH", "FREECAD_EXE", "FREECAD_CMD_EXE"],
      "startup_timeout_sec": 15,
      "tool_timeout_sec": 300
    }
  }
}
