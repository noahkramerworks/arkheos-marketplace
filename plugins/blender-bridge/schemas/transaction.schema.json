{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blender-bridge/transaction/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["projectFile", "transactionId", "expectedRevision", "actions"],
  "properties": {
    "projectFile": {"type": "string"},
    "transactionId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "expectedRevision": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "externalInputs": {"type": "array", "maxItems": 32, "items": {"type": "string"}},
    "externalWrites": {"type": "array", "maxItems": 32, "items": {"type": "string"}},
    "actions": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "object", "required": ["type"], "properties": {"type": {"enum": ["ensure_collection", "create_object", "set_transform", "create_mesh", "edit_mesh", "create_curve", "create_text", "add_modifier", "ensure_material", "set_material_nodes", "ensure_geometry_nodes", "ensure_camera", "ensure_light", "set_world", "set_render", "ensure_armature", "add_bone", "set_pose", "set_weights", "ensure_action", "insert_keyframe", "import_asset", "save_project"]}}}}
  }
}
